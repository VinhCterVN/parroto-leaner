# Required: Parroto Bearer / Access Token (JWT)
BEARER_TOKEN="your_bearer_token_here"

# Required: Parroto Refresh Token
REFRESH_TOKEN="access_token_here"

# Required : apiKey
API_KEY="api_key_here"

# Optional configurations
# Next.js build ID (defaults to bWYuKDgCvminqE7L8hyo1, auto-resolved if outdated)
BUILD_ID="bWYuKDgCvminqE7L8hyo1"

# Concurrency level for simultaneous requests (default: 10)
CONCURRENCY=10

# Rating level: 'again', 'hard', 'good', 'easy' (default: 'again')
RATING="again"

# File to store scraped cards (default: data/cards.json)
CARDS_FILE="data/cards.json"

# Loop interval in minutes when running in loop mode (default: 10)
LOOP_INTERVAL_MINUTES=10

# Delay in seconds between requests in linear mode (default: 0.5)
LINEAR_DELAY=0.5

# Cooldown delay in seconds when hitting HTTP 429 Too Many Requests (default: 10.0)
COOLDOWN_429=10.0

# Heartbeat interval in minutes when --heartbeat is active (default: 5)
HEARTBEAT_INTERVAL_MINUTES=5

# Optionally enable heartbeat by default without passing --heartbeat flag (default: false)
# ENABLE_HEARTBEAT=true